# Copy this file to .env (or set these in your hosting dashboard).

# Password for the owner page at /owner.html, where you see every winner and their ticket code.
# Use something long. Leave empty to turn the owner page off.
ADMIN_PASSWORD=

# Optional
# PORT=3000
# TRUST_PROXY=1        # leave at 1 on Render/Railway/Fly/Heroku etc. Set to false if the app is reached directly.
# DATA_FILE=./data.json
# WIN_ODDS=10000       # testing only: set to 2 to see the win screen quickly
